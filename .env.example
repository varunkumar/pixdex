# Server-side only (dev proxy + Pages Function). Do NOT prefix with VITE_.
WORKER_URL=https://pixdex-worker.<your-subdomain>.workers.dev
READ_TOKEN=replace-with-the-same-value-as-the-worker's-READ_TOKEN-secret

# Identity (Pages Function env). The Function verifies the Cloudflare Access JWT
# against https://<ACCESS_TEAM_DOMAIN>/cdn-cgi/access/certs and its audience tag,
# then forwards the verified email to the Worker. If either is unset, every /api
# request fails closed. OWNER_EMAIL is not read here (it lives in agent/.env); it only
# feeds the dev proxy below as the fallback viewer.
ACCESS_TEAM_DOMAIN=<your-team>.cloudflareaccess.com
ACCESS_AUD=replace-with-the-pages-access-application-audience-tag

# Local dev only (npm run dev): the Vite proxy sends this as the viewer email
# instead of OWNER_EMAIL, to preview the app as a user an album is shared with.
# DEV_VIEWER_EMAIL=friend@example.com

# Optional: only needed for "View Original" on local-disk photos, once
# agent/cloudflared is set up (see agent/cloudflared/README.md). Server-side
# only; ORIGINALS_TOKEN must match agent/.env's ORIGINALS_TOKEN.
ORIGINALS_BASE_URL=https://pixdex-originals.<your-domain>
ORIGINALS_TOKEN=replace-with-the-same-value-as-agent/.env's-ORIGINALS_TOKEN

# Optional hardening: a Cloudflare Access service token (Zero Trust > Access >
# Service auth) with a Service Auth policy on the originals hostname. When set,
# the proxy sends it as CF-Access-Client-Id/-Secret on /api/originals requests.
# ACCESS_CLIENT_ID=<id>.access
# ACCESS_CLIENT_SECRET=<secret>
