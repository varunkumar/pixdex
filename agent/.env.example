CLOUDFLARE_API_BASE_URL=https://pixdex-worker.<your-subdomain>.workers.dev
INGEST_TOKEN=replace-with-the-same-value-as-the-worker-secret
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:27b-mlx

# Optional: required only for Google Drive folder-scoped indexing.
# Create an OAuth client (type: Desktop app) in Google Cloud Console and
# register this exact redirect URI on it:
#   http://localhost:53682/oauth2callback
# The agent requests the drive.readonly scope
# (https://www.googleapis.com/auth/drive.readonly).
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
