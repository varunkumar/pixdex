CLOUDFLARE_API_BASE_URL=https://pixdex-worker.<your-subdomain>.workers.dev
INGEST_TOKEN=replace-with-the-same-value-as-the-worker-secret
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:27b-mlx

# Optional: required only for Google Drive folder-scoped indexing.
# Create an OAuth client (type: Desktop app) in Google Cloud Console and
# register this exact redirect URI on it:
#   http://localhost:53682/oauth2callback
# The agent requests the drive.readonly scope
# (https://www.googleapis.com/auth/drive.readonly).
GOOGLE_OAUTH_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
# Optional: Drive photos are downloaded one at a time to a temp folder and deleted right after
# each is processed. A photo larger than this many MB is refused before download (default 1024).
# DRIVE_STAGING_MAX_MB=1024

# Optional: required only for `pixdex-agent serve-originals` (the
# Cloudflare Tunnel that exposes full-resolution local-disk originals).
# ORIGINALS_PORT is the local port the server listens on; cloudflared's
# ingress config (agent/cloudflared/config.yml) must point at the same one.
# READ_TOKEN must match the worker's READ_TOKEN secret; it's used to look up
# the photo's local path via the worker's (now token-gated) GET /photos/:id.
# OWNER_EMAIL (required to index, whatever the section) is the album owner (your Google sign-in email). Indexing sends it as ownerEmail on
# every photo (the first photo of an album stamps its owner), and the originals lookup is made as
# that user (sent as X-Viewer-Email, which the worker requires on every read).
# `index-status` uses READ_TOKEN and OWNER_EMAIL the same way for its live counts.
# The Worker and Pages do not read OWNER_EMAIL.
ORIGINALS_PORT=8787
ORIGINALS_TOKEN=replace-with-a-random-shared-secret
READ_TOKEN=replace-with-the-same-value-as-the-worker-secret
OWNER_EMAIL=you@example.com

# Optional: turns on face scanning. Start the sidecar first (see
# agent/sidecar/README.md); indexing then detects faces after each photo and
# `backfill-faces` fills in the existing library. Leave unset to skip faces.
# FACE_SIDECAR_URL=http://127.0.0.1:8799

# Optional: identifies the known-gallery builder to Wikimedia (an email or a
# project URL, sent only in the User-Agent, never logged). Without it Wikimedia
# allows 10 API requests per minute, with it 200. Keep it local, never commit it.
# WIKIMEDIA_CONTACT=you@example.org
